# Run in Kibana Dev Tools. The first two resources are shared by Runner and Mocker.
# Attach the ingest pipeline and field mappings to the daily log indices as described in the README before starting.
# Creating the destination and transform is a one-time operation. Keep existing data on reconfiguration.

PUT /_ingest/pipeline/qaas-usage-stamp-v1
{
  "description": "Stamp QaaS usage records at ingestion for late/replayed event reconciliation.",
  "processors": [
    {
      "script": {
        "if": "ctx.fields?.AttemptId != null",
        "source": """
def f = ctx.fields;
if (f == null || f.AttemptId == null || f.QaasEvent == null) return;
if (f.QaasEvent == 'MockerHttpRequests' && f.ServerId != null && f.BatchSequence != null) {
  ctx.qaas_usage_key = 'm/http/' + f.ServerId + '/' + f.BatchSequence;
} else if (f.QaasEvent == 'RunnerExecutionStarted' || f.QaasEvent == 'RunnerExecutionFinished') {
  ctx.qaas_usage_key = 'r/run/' + f.AttemptId;
} else if (f.QaasEvent == 'MockerExecutionStarted' || f.QaasEvent == 'MockerExecutionFinished') {
  ctx.qaas_usage_key = 'm/run/' + f.AttemptId;
}
"""
      }
    },
    {
      "set": {
        "if": "ctx.qaas_usage_key != null",
        "field": "qaas_usage_ingested",
        "value": "{{{_ingest.timestamp}}}"
      }
    }
  ]
}

PUT /_component_template/qaas-usage-fields-v1
{
  "template": {
    "mappings": {
      "properties": {
        "qaas_usage_key": {
          "type": "keyword"
        },
        "qaas_usage_ingested": {
          "type": "date"
        }
      }
    }
  }
}

PUT /qaasusage-runner-v1
{
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "key": {
        "type": "keyword"
      },
      "event": {
        "properties": {
          "AttemptId": {
            "type": "keyword"
          },
          "Team": {
            "type": "keyword"
          },
          "System": {
            "type": "keyword"
          },
          "Project": {
            "type": "keyword"
          },
          "TeamKnown": {
            "type": "boolean"
          },
          "SystemKnown": {
            "type": "boolean"
          },
          "ProjectKnown": {
            "type": "boolean"
          },
          "Version": {
            "type": "keyword"
          },
          "ExecutionType": {
            "type": "keyword"
          },
          "Environment": {
            "type": "keyword"
          },
          "Features": {
            "type": "keyword"
          },
          "DurationMs": {
            "type": "double"
          },
          "Outcome": {
            "type": "keyword"
          },
          "Failed": {
            "type": "long"
          },
          "IsBatch": {
            "type": "boolean"
          },
          "IsCase": {
            "type": "boolean"
          },
          "TestsExecuted": {
            "type": "long"
          },
          "AssertionsExecuted": {
            "type": "long"
          },
          "Time": {
            "type": "date"
          },
          "StartedAt": {
            "type": "date"
          },
          "FinishedAt": {
            "type": "date"
          },
          "BatchAt": {
            "type": "date"
          },
          "Kind": {
            "type": "keyword"
          },
          "Conflict": {
            "type": "boolean"
          },
          "Invocation": {
            "type": "keyword"
          }
        }
      }
    }
  }
}

PUT /_transform/qaasusage-runner-v1
{
  "description": "Runner usage. Reconcile each attempt across phases and each nonempty HTTP batch across deliveries.",
  "source": {
    "index": "qaas-20*",
    "query": {
      "prefix": {
        "qaas_usage_key": "r/"
      }
    }
  },
  "dest": {
    "index": "qaasusage-runner-v1"
  },
  "frequency": "30s",
  "sync": {
    "time": {
      "field": "qaas_usage_ingested",
      "delay": "10s"
    }
  },
  "settings": {
    "max_page_search_size": 200
  },
  "pivot": {
    "group_by": {
      "key": {
        "terms": {
          "field": "qaas_usage_key"
        }
      }
    },
    "aggregations": {
      "event": {
        "scripted_metric": {
          "params": {
            "keep": [
              "AttemptId",
              "Team",
              "System",
              "Project",
              "TeamKnown",
              "SystemKnown",
              "ProjectKnown",
              "Version",
              "ExecutionType",
              "Environment",
              "Features",
              "DurationMs",
              "Outcome",
              "Failed",
              "IsBatch",
              "IsCase",
              "TestsExecuted",
              "AssertionsExecuted"
            ]
          },
          "init_script": "state.conflict = false;",
          "map_script": """
def f = params._source.fields;
def kind = f.QaasEvent == 'MockerHttpRequests' ? 'batch' : (f.QaasEvent.endsWith('Started') ? 'start' : 'finish');
def values = new HashMap();
for (def key : params.keep) {
  if (f[key] != null) values[key] = f[key];
}
long ts = doc['@timestamp'].value.toInstant().toEpochMilli();
def prior = state[kind];
if (prior != null && !prior.values.equals(values)) state.conflict = true;
if (prior == null || ts < prior.at) state[kind] = ['at':ts, 'values':values];
""",
          "combine_script": "return state;",
          "reduce_script": """
def phases = new HashMap();
boolean conflict = false;
for (def part : states) {
  if (part == null) continue;
  if (part.conflict == true) conflict = true;
  for (def phase : ['start','finish','batch']) {
    def next = part[phase];
    if (next == null) continue;
    def old = phases[phase];
    if (old != null && !old.values.equals(next.values)) conflict = true;
    if (old == null || next.at < old.at) phases[phase] = next;
  }
}
def start = phases.start;
def finish = phases.finish;
def batch = phases.batch;
def row = new HashMap();
if (start != null && finish != null) {
  for (def key : ['Team','Project','System','TeamKnown','ProjectKnown','SystemKnown','Version','ExecutionType','Environment','Features','IsBatch','IsCase']) {
    if (start.values[key] != finish.values[key]) conflict = true;
  }
}
if (batch != null) {
  row.putAll(batch.values);
  row.Kind = 'HTTP';
  row.BatchAt = batch.at;
  row.Time = [batch.at];
} else {
  row.Kind = 'Execution';
  row.Time = new ArrayList();
  if (finish != null) {
    row.putAll(finish.values);
    row.FinishedAt = finish.at;
    row.Time.add(finish.at);
  }
  if (start != null) {
    row.putAll(start.values);
    row.StartedAt = start.at;
    row.Time.add(start.at);
  }
}
if (row.Features == null || (row.Features instanceof List && row.Features.isEmpty())) row.Features = ['none'];
if (row.Environment == null) row.Environment = 'Unknown';
if (row.Version == null) row.Version = 'Unknown';
for (def axis : ['Team','Project','System']) {
  if (row[axis+'Known'] != true || row[axis] == null) {
    row[axis] = '(unattributed)';
    row[axis+'Known'] = false;
  }
}
if (row.containsKey('IsCase')) {
  row.Invocation = row.IsBatch == true ? (row.IsCase == true ? 'Batch case' : 'Batch command')
                                       : (row.IsCase == true ? 'Named case' : 'Standalone');
}
row.Conflict = conflict;
return row;
"""
        }
      }
    }
  }
}

POST /_transform/qaasusage-runner-v1/_start
