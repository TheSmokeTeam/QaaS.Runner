{
  "uid": "qaas-runner-terminal-kpi",
  "title": "QaaS | Observed Runner usage and coverage",
  "description": "Fixed UTC windows independent of the time picker. Privacy-bounded observed scopes. Not installation estimates.",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "editable": true,
  "timepicker": {
    "hidden": true
  },
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "qaas",
    "runner",
    "terminal-kpi"
  ],
  "panels": [
    {
      "type": "text",
      "title": "Scope and data limits",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Observed Runner terminal data only.** Eligibility and expected attempts are independent inventories, not inferred from sent events. No data is not zero. A missing terminal is not evidence of inactivity or failure. Use the snapshot cutoff to detect stale readouts. Per-operation cards do not infer the internal stages of a run."
      }
    },
    {
      "type": "row",
      "title": "Observed adoption",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Observed eligible adoption",
      "description": "Observed active eligible projects divided by independently eligible projects.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "qaas-runner-kpi"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "qaas_runner_kpi_adoption_ratio{job=\"qaas_runner_kpi\",window=\"$window\",team=\"$team\",environment=\"$environment\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qaas-runner-kpi"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
